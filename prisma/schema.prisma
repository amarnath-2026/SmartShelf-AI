generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Store {
  id                    String                 @id @default(uuid())
  name                  String
  code                  String                 @unique
  address               String?
  phone                 String?
  email                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  users                 User[]
  categories            Category[]
  suppliers             Supplier[]
  products              Product[]
  batches               Batch[]
  sales                 Sale[]
  transactions          InventoryTransaction[]
  alerts                ExpiryAlert[]
  notifications         Notification[]
  aiRecommendations     AIRecommendation[]
  directives            StaffDirective[]
  stockAllocations      StockAllocation[]
  settings              StoreSettings?
}

model User {
  id                    String                 @id @default(uuid())
  storeId               String
  name                  String
  email                 String                 @unique
  password              String
  role                  String                 @default("STAFF") // OWNER, SUPERVISOR, STAFF, MANAGER
  avatar                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales                 Sale[]
  transactions          InventoryTransaction[]
  directivesCreated     StaffDirective[]

  @@index([storeId])
  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  icon        String?   @default("Package")
  color       String?   @default("emerald")
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([storeId])
}

model Supplier {
  id            String    @id @default(uuid())
  storeId       String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([storeId])
}

model Product {
  id                String                 @id @default(uuid())
  storeId           String
  categoryId        String
  supplierId        String?
  name              String
  barcode           String                 
  brand             String?
  description       String?
  unit              String                 @default("pcs") // pcs, kg, g, l, ml, pack
  purchasePrice     Float                  @default(0.0)
  sellingPrice      Float                  @default(0.0)
  minStockLevel     Int                    @default(10)
  imageUrl          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  store             Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category               @relation(fields: [categoryId], references: [id])
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  batches           Batch[]
  saleItems         SaleItem[]
  transactions      InventoryTransaction[]
  aiRecommendations AIRecommendation[]

  @@index([storeId])
  @@index([categoryId])
  @@index([barcode])
}

model Batch {
  id                  String                 @id @default(uuid())
  productId           String
  storeId             String
  batchNumber         String
  quantity            Int
  initialQuantity     Int
  mfgDate             DateTime
  expiryDate          DateTime
  storageLocation     String                 @default("Main Shelf")
  status              String                 @default("SAFE") // SAFE, WATCH, WARNING, URGENT, CRITICAL, EXPIRES_TODAY, EXPIRED
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  store               Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems           SaleItem[]
  transactions        InventoryTransaction[]
  alerts              ExpiryAlert[]
  aiRecommendations   AIRecommendation[]

  @@index([storeId])
  @@index([productId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model Sale {
  id            String     @id @default(uuid())
  storeId       String
  userId        String?
  invoiceNo     String     @unique
  totalAmount   Float
  paymentMethod String     @default("CASH") // CASH, CARD, UPI
  customerName  String?    @default("Walk-in Customer")
  createdAt     DateTime   @default(now())

  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user          User?      @relation(fields: [userId], references: [id])
  items         SaleItem[]

  @@index([storeId])
  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  batchId     String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  batch       Batch    @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([batchId])
}

model InventoryTransaction {
  id          String   @id @default(uuid())
  storeId     String
  productId   String
  batchId     String
  userId      String?
  type        String   // STOCK_IN, SALE, DISCARD, ADJUSTMENT
  quantity    Int
  reason      String?
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  batch       Batch    @relation(fields: [batchId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([createdAt])
}

model ExpiryAlert {
  id            String   @id @default(uuid())
  storeId       String
  batchId       String
  riskLevel     String   // WATCH, WARNING, URGENT, CRITICAL, EXPIRED
  daysRemaining Int
  isResolved    Boolean  @default(false)
  actionTaken   String?  // PROMO_DISCOUNT, SELL_FIRST, DISCARDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([isResolved])
}

model Notification {
  id          String   @id @default(uuid())
  storeId     String
  title       String
  message     String
  type        String   @default("INFO") // CRITICAL, WARNING, INFO, AI
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([read])
}

model AIRecommendation {
  id                String   @id @default(uuid())
  storeId           String
  productId         String
  batchId           String
  title             String
  recommendation    String
  expectedLeftover  Int
  riskScore         Float    // 0.0 - 100.0
  actionType        String   @default("SELL_FIRST") // SELL_FIRST, DISCOUNT_20, DISCOUNT_50, REORDER
  createdAt         DateTime @default(now())

  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model StoreSettings {
  id                   String   @id @default(uuid())
  storeId              String   @unique
  watchDays            Int      @default(30)
  warningDays          Int      @default(14)
  urgentDays           Int      @default(6)
  criticalDays         Int      @default(2)
  autoDiscountEnabled  Boolean  @default(true)
  currencySymbol       String   @default("₹")
  updatedAt            DateTime @updatedAt

  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StaffDirective {
  id            String    @id @default(uuid())
  storeId       String
  createdById   String?
  productId     String?
  batchId       String?
  title         String
  message       String
  priority      String    @default("URGENT") // NORMAL, URGENT, CRITICAL
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation(fields: [createdById], references: [id])

  @@index([storeId])
  @@index([status])
}

model StockAllocation {
  id                String    @id @default(uuid())
  storeId           String
  productId         String
  batchNumber       String
  shippedQuantity   Int
  receivedQuantity  Int       @default(0)
  mfgDate           DateTime
  expiryDate        DateTime
  status            String    @default("IN_TRANSIT") // IN_TRANSIT, RECEIVED, PARTIAL
  dispatchedAt      DateTime  @default(now())
  receivedAt        DateTime?

  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
}
